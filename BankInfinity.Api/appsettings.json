{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "YOUR_LOCAL_SECRET_KEY_PLACEHOLDER",
    "Issuer": "BankInfinityApi",
    "Audience": "BankInfinityUsers",
    "ExpirationInMinutes": 60
  },
  "SmtpSettings": {
    "Server": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "BankInfinity API",
    "SenderEmail": "YOUR_EMAIL_HERE",
    "Username": "YOUR_USERNAME_HERE",
    "Password": "YOUR_APP_PASSWORD_HERE"
  }
}